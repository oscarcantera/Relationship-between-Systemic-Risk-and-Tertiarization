   "source": [
    "from pathlib import Path\n",
    "import yaml\n",
    "from edgar import set_identity, use_local_storage, is_using_local_storage, Company\n",
    "\n",
    "CONFIG_PATH = Path(\"config/path.yaml\")\n",
    "\n",
    "with open(CONFIG_PATH, \"r\", encoding=\"utf-8\") as f:\n",
    "    PATHS = yaml.safe_load(f)\n",
    "\n",
    "EDGAR_LOCAL_DIR = Path(PATHS[\"edgar_local_dir\"]).expanduser().resolve()\n",
    "EDGAR_LOCAL_DIR.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "set_identity(\"Oscar Cantera ocantera4@alumno.uned.es\")\n",
    "use_local_storage(str(EDGAR_LOCAL_DIR))\n",
    "\n",
    "print(\"Usando almacenamiento local:\", is_using_local_storage())\n",
    "print(\"Ruta EDGAR:\", EDGAR_LOCAL_DIR)\n",
    "\n",
    "company = Company(\"AAPL\")\n",
    "print(company)"
   ]
  },
